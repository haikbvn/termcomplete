{
  "name": "root",
  "private": true,
  "author": "Amazon Web Services",
  "repository": "https://github.com/haikbvn/termcomplete",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@10.0.0+sha256.43abf6e720fb7bc53c591b0862605c7d323d0a9d2dd33bcac07b062e13cf4948",
  "type": "module",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "build": "turbo build --filter=@amzn/autocomplete-app --filter=@amzn/dashboard-app",
    "b": "turbo build",
    "format": "cargo fmt",
    "clippy": "cargo clippy --locked --workspace --color always -- -D warnings",
    "test": "vitest",
    "test:ci": "vitest run --run --coverage",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "turbo lint --parallel",
    "lint:fix": "turbo lint:fix --parallel",
    "dev": "turbo dev",
    "dev:autocomplete": "pnpm -C packages/autocomplete-app dev",
    "dev:dashboard": "pnpm -C packages/dashboard-app dev",
    "preview:autocomplete": "pnpm -C packages/autocomplete-app preview",
    "preview:dashboard": "pnpm -C packages/dashboard-app preview",
    "clean": "turbo clean --parallel",
    "prepare": "",
    "precommit": "lint-staged --config .lintstagedrc.mjs",
    "setup": "bash scripts/bootstrap.sh",
    "build:specs": "node scripts/bundle-specs.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.8",
    "@vitest/ui": "^3.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "micromatch": "^4.0.8",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "turbo": "^2.5.2",
    "vitest": "^3.0.8",
    "esbuild": "0.25.1",
    "typescript": "5.8.3",
    "@fig/autocomplete-generators": "2.4.0",
    "@fig/autocomplete-helpers": "2.0.0",
    "yaml": "2.7.0",
    "semver": "7.7.0",
    "strip-json-comments": "5.0.1"
  }
}
